includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    # Cache de résultats dans l'arbre (au lieu du tmp système) pour que le
    # cache GitLab CI puisse le persister entre pipelines : sur code inchangé,
    # l'analyse retombe à quelques secondes au lieu de repartir à froid.
    tmpDir: tmp/phpstan
    paths:
      - tests
      - config/constants.php
      - config/functions.php
      - src
      - api/tutorial
      - admin
      - classements.php
    scanFiles:
      # Global helper required at runtime via config.php (not autoloaded), so
      # PHPStan needs it pointed out to discover aoo_deploy_env().
      - config/deploy_targets.php
