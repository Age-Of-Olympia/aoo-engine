includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
      - tests
      - config/constants.php
      - config/functions.php
      - src
      - api/tutorial
      - admin
      - classements.php
    scanFiles:
      # Global helper required at runtime via config.php (not autoloaded), so
      # PHPStan needs it pointed out to discover aoo_deploy_env().
      - config/deploy_targets.php
